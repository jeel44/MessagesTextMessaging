# Android Studio / IDE
*.iml
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.DS_Store

# Gradle and build output
.gradle
build/
**/build/
/captures
.externalNativeBuild
.cxx

# Local machine files
local.properties
keystore.properties
*.apk
*.db
jadx-*/