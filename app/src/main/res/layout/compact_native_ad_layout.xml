<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-row native ad asset views for CompactNativeAdCard.kt (Splash): icon | headline + body |
  "Ad" label | CTA, about 60dp tall. Deliberately no MediaView: Google allows native ads without
  media below ~120dp, and this slot is half that. A real View hierarchy for the same reason as
  native_ad_layout.xml: the Native Ads API registers genuine View instances for click/impression
  tracking. Colors/rounding are set programmatically in CompactNativeAdCard's `update` block.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/compact_native_ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/compact_native_ad_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compact_native_ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_native_ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/compact_native_ad_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textSize="10sp"
            android:textStyle="bold" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compact_native_ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
