<?xml version="1.0" encoding="utf-8"?>
<!--
  Native ad asset views for MediumNativeAdCard.kt (Intro): native_ad_layout.xml minus its
  MediaView: "Ad" label, icon | headline + 2-line body, full-width CTA, about 150dp tall.
  Deliberately no MediaView: Google allows native ads without media below ~120dp of media space,
  and this card leaves none. A real View hierarchy for the same reason as native_ad_layout.xml:
  the Native Ads API registers genuine View instances for click/impression tracking.
  Colors/rounding are set programmatically in MediumNativeAdCard's `update` block.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/medium_native_ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/medium_native_ad_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/medium_native_ad_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/medium_native_ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/medium_native_ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/medium_native_ad_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
