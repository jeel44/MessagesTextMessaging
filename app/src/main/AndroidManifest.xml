<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Telephony is what the app is for, but it is not marked required: a tablet or ChromeOS
      device can still install and browse history. Every send path checks at runtime.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Messaging -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Legacy: the platform stopped granting WRITE_SMS at API 19, but carriers and OEM
         builds still check for the declaration. -->
    <uses-permission
        android:name="android.permission.WRITE_SMS"
        tools:ignore="SystemPermissionTypo" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!-- Contacts, for resolving addresses to names -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- MMS transfer happens over the carrier data connection -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Multi-SIM selection and the subscription a message travelled on -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Call-end screen: number/call-type lookup after a call ends -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Call-end screen's launch trigger: PhoneStateReceiver (a manifest-registered receiver on
         the exempted PHONE_STATE implicit broadcast) starts CallEndTriggerService for the span of
         a single call, which launches CallEndActivity directly when the call ends; see
         PhoneStateReceiver's and CallEndTriggerService's own doc comments, and SYSTEM_ALERT_WINDOW
         below. Deliberately NOT a persistent, always-running service (see CallEndTriggerService's
         doc comment for why).

         FOREGROUND_SERVICE_PHONE_CALL + MANAGE_OWN_CALLS: the "phoneCall" FGS type is restricted
         (targetSdk 34+) to apps holding MANAGE_OWN_CALLS or the system dialer/DIALER role.
         MANAGE_OWN_CALLS is an install-time permission here, not tied to holding the dialer role;
         this app still never places or manages a call itself, it only watches TelephonyManager
         call-state transitions via PHONE_STATE to know when one ended. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- "Appear on top", requested during onboarding by OverlayPermissionScreen. Used two ways:
         (1) BackgroundActivityLaunchOverlay attaches a transient, invisible 1x1
         TYPE_APPLICATION_OVERLAY window around each background launch this app makes (starting
         CallEndTriggerService, then launching CallEndActivity) to exempt it from the platform's
         background-activity-launch restrictions; (2) CallEndTriggerService also gates the
         CallEndActivity launch itself on Settings.canDrawOverlays() being true at all, falling
         back to doing nothing (DEBUG-log only) if the permission isn't granted. See
         OverlayPermissionGuard, BackgroundActivityLaunchOverlay and CallEndTriggerService's own
         doc comments. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Scheduled sends have to survive a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Chat composer's Camera attachment action delegates to whatever camera app is
         installed via ACTION_IMAGE_CAPTURE; package-visibility rules on API 30+ require it to
         be declared here or resolution can silently fail on some OEM builds.

         The three <package> entries below are for the call-end screen's quick-launch row (see
         CallEndViewModel.isPackageInstalled/QuickLaunchApps): without them, PackageManager
         .getPackageInfo() for another app's package throws NameNotFoundException on API 30+ even
         when that app is genuinely installed, so every quick-launch tile silently stayed hidden
         regardless of what was actually on the device. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
    </queries>

    <!--
      allowBackup=false is deliberate, not the unfilled default. Auto Backup/cloud-backup with no
      exclude rules backs up every app-private file, including the onboarding-complete DataStore
      flag and the local Room cache, so a "fresh" reinstall (same package, same signing key,
      backed-up device) silently restored onboarding_complete=true and skipped onboarding
      entirely, even though the OS had already reset every runtime permission and the default-SMS
      role. All of this app's local storage mirrors the system Telephony/Contacts providers and
      is fully rebuildable from a resync; none of it should survive a reinstall.
    -->
    <application
        android:name=".MessagingApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Messaging">

        <!-- AdMob: Google's official TEST App ID (ca-app-pub-3940256099942544~3347511713).
             Swap for the real AdMob App ID in a separate, config-only commit once it's available;
             see CallEndAdLoader's own doc comment for the matching TEST ad unit IDs. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Default-SMS-app requirement 1 of 4: handle SENDTO so the system can hand the app
              a number to message.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          Requirement 2 of 4: receive SMS_DELIVER. Only the default SMS app gets this broadcast,
          and it alone is responsible for writing the message to the provider.
        -->
        <receiver
            android:name=".data.receiver.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Requirement 3 of 4: receive WAP_PUSH_DELIVER for inbound MMS. -->
        <receiver
            android:name=".data.receiver.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Result broadcasts for messages this app sent; not exported to other apps. -->
        <receiver
            android:name=".data.receiver.MessageSentReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.receiver.MessageDeliveredReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.receiver.MmsSendResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.receiver.MmsDownloadResultReceiver"
            android:exported="false" />

        <!-- "Mark as read"/"Reply" actions on an IncomingMessageNotifier notification; only
             this app's own explicit-component PendingIntents ever target it. -->
        <receiver
            android:name=".data.receiver.NotificationActionReceiver"
            android:exported="false" />

        <!-- WorkManager's own persisted jobs already survive a reboot; this only re-verifies
             that survival, see the note on ScheduledSendWorker. BOOT_COMPLETED is a protected
             broadcast the system alone can send, so exporting it is not a write surface. -->
        <receiver
            android:name=".data.receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          This app supplies its own androidx.work.Configuration (see MessagingApplication) so
          Hilt-injected Workers can be constructed; the default on-demand initializer would
          build WorkManager with a plain factory instead and crash the first time a
          @HiltWorker-annotated Worker is requested, so it is removed here.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Manifest-registered receiver for the PHONE_STATE implicit broadcast; see
             PhoneStateReceiver's own doc comment for why this can be a manifest receiver at all
             (most implicit broadcasts can't, post-API-26) and why nothing needs to bootstrap it. -->
        <receiver
            android:name=".service.PhoneStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Short-lived foreground service: started by PhoneStateReceiver for the span of a
             single call, launches CallEndActivity directly when that call ends, then stops
             itself; see CallStateMonitor and CallEndTriggerService's own doc comment for why this
             is NOT a persistent, always-running service. -->
        <service
            android:name=".service.CallEndTriggerService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <!-- Full-screen call-end popup, launched directly by CallEndTriggerService (no
             notification). Its own task (taskAffinity + singleTask), excluded from Recents, so
             back/close returns to whatever the user was doing before the call, not into
             MainActivity's task; see CallEndActivity's own doc comment. -->
        <activity
            android:name=".ui.screens.callend.CallEndActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="locale|layoutDirection"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.callend"
            android:theme="@style/Theme.Messaging" />

        <!--
          Requirement 4 of 4: respond to a call declined with a canned reply. QUICK_RESPONSE is
          the equivalent action older dialers send.
        -->
        <service
            android:name=".service.QuickResponseService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <action android:name="android.intent.action.QUICK_RESPONSE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
    </application>

</manifest>
